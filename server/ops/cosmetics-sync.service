[Unit]
Description=Essential Patcher cosmetic sync
After=network.target

[Service]
Type=simple
User=cosmeticsync
Group=cosmeticsync
WorkingDirectory=/opt/cosmetics-sync
EnvironmentFile=/opt/cosmetics-sync/.env
ExecStart=/usr/bin/python3 -m uvicorn cosmeticsync.app:app --host 127.0.0.1 --port 7100
Restart=always
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
